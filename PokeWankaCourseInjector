        help_win = tk.Toplevel(self.root)
        help_win.title("Help Documentation")
        help_win.geometry("720x1080")
        text_area = scrolledtext.ScrolledText(help_win, wrap=tk.WORD, width=60, height=20)
        text_area.pack(padx=10, pady=10, fill=tk.BOTH, expand=True)
        help_text = """Pokéwalker Course Editor - Cheat Generator

========================================
1. Strict Formatting Rules
========================================
To generate a valid Action Replay code, your course MUST strictly contain:
- Exactly 6 Pokémon (2 in Group A, 2 in Group B, 2 in Group C)
- Exactly 10 Items
