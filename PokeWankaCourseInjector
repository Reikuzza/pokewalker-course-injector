        self.slot_var.set(self.course_data.get("target_slot", COURSE_SLOTS[0]))
        self.game_var.set(self.course_data.get("target_game", GAME_LIST[0]))
        self.region_var.set(self.course_data.get("target_region", REGION_LIST[0]))
        self.watts_var.set(str(self.course_data["watts"]))
        self.route_var.set(self.course_data["route_image"])
        self.type1_var.set(self.course_data["type1"])
        self.type2_var.set(self.course_data["type2"])
        self.type3_var.set(self.course_data["type3"])

        self.poke_list.delete(0, tk.END)
        groups = ["Group A", "Group A", "Group B", "Group B", "Group C", "Group C"]
        for idx, p in enumerate(self.course_data["pokemon"]):
            label = f"[{groups[idx]}] {p['species']} Lv{p['level']} (Wt:{p['rarity']}) - [{p['steps']} Steps]"
            self.poke_list.insert(tk.END, label)

        self.item_list.delete(0, tk.END)
        for idx, it in enumerate(self.course_data["items"]):
            label = f"[Slot {idx+1}] {it['name']} (Wt:{it['rarity']}) - [{it['steps']} Steps]"
            self.item_list.insert(tk.END, label)

    def update_data_from_ui(self):
        self.course_data["name"] = self.name_var.get()
        self.course_data["target_slot"] = self.slot_var.get()
        self.course_data["target_game"] = self.game_var.get()
        self.course_data["target_region"] = self.region_var.get()
        try:
            self.course_data["watts"] = int(self.watts_var.get())
        except ValueError:
            self.course_data["watts"] = 0
            self.watts_var.set("0")
        self.course_data["route_image"] = self.route_var.get()
        self.course_data["type1"] = self.type1_var.get()
        self.course_data["type2"] = self.type2_var.get()
        self.course_data["type3"] = self.type3_var.get()

    def edit_pokemon(self):
        idx = self.poke_list.curselection()
        if not idx:
            return
        i = idx[0]
        current = self.course_data["pokemon"][i]
        dialog = PokemonDialog(self.root, f"Edit Pokemon Slot {i+1}", current)
        if dialog.result:
            self.course_data["pokemon"][i] = dialog.result
            self.refresh_ui()

    def edit_item(self):
        idx = self.item_list.curselection()
        if not idx:
            return
        i = idx[0]
        current = self.course_data["items"][i]
        dialog = ItemDialog(self.root, f"Edit Item Slot {i+1}", current)
        if dialog.result:
            self.course_data["items"][i] = dialog.result
            self.refresh_ui()

    # ---------- JSON Load/Save ----------

    def open_course(self):
        path = filedialog.askopenfilename(filetypes=[("JSON files", "*.json")])
        if not path:
            return
        try:
            with open(path, "r", encoding="utf-8") as f:
                loaded = json.load(f)
            
            if len(loaded.get("pokemon", [])) != 6 or len(loaded.get("items", [])) != 10:
                messagebox.showerror("Error", "Invalid JSON. Must contain exactly 6 Pokemon and 10 Items.")
                return

            self.course_data = loaded
            self.current_file = path
            self.refresh_ui()
        except Exception as e:
            messagebox.showerror("Error", f"Failed to load JSON:\n{e}")

    def save_course(self):
        self.update_data_from_ui()
        if not self.current_file:
            self.current_file = filedialog.asksaveasfilename(defaultextension=".json", filetypes=[("JSON files", "*.json")])
        if not self.current_file:
            return
        try:
            with open(self.current_file, "w", encoding="utf-8") as f:
                json.dump(self.course_data, f, indent=2)
            messagebox.showinfo("Saved", f"Configuration saved to {self.current_file}")
        except Exception as e:
            messagebox.showerror("Error", f"Failed to save JSON:\n{e}")

    # ---------- LINCOLN'S EXPORT ENGINE ----------

    def generate_ar_text(self):
        self.update_data_from_ui()
        try:
            target_str = self.course_data["target_slot"]
            target_index = int(target_str.split(" - ")[0])

            watts = self.course_data["watts"]
            route = RouteImage[self.course_data["route_image"]]
            types = [Type[self.course_data["type1"]], Type[self.course_data["type2"]], Type[self.course_data["type3"]]]

            p_slots = []
            for p in self.course_data["pokemon"]:
                p_slots.append(PokeWalkerSlot(
                    species=Species[p["species"]], level=p["level"], item=p["held_item"],
                    form=p["form"], gender=Gender["MALE"],
                    moves=[Move[p["move1"]], Move[p["move2"]], Move[p["move3"]], Move[p["move4"]]],
                    step_requirement=p["steps"], rarity_weight=p["rarity"]
                ))

            i_slots = []
            for i in self.course_data["items"]:
                i_slots.append(PokeWalkerItem(item=i["name"], step_requirement=i["steps"], rarity_weight=i["rarity"]))

            course = PokeWalkerCourse(
                target_course_index=target_index, watt_requirement=watts, route_image=route,
                group_a=p_slots[0:2], group_b=p_slots[2:4], group_c=p_slots[4:6],
                items=i_slots, special_types=types
            )

            code = course.to_ar_code()
            
            self.ar_text.configure(state='normal')
            self.ar_text.delete(1.0, tk.END)
            self.ar_text.insert(tk.END, code)
            self.ar_text.configure(state='disabled')
            messagebox.showinfo("Success", "Raw AR Code generated! You can copy it from the text box and paste it into R4CCE.")
            
        except Exception as e:
            messagebox.showerror("Error", f"Failed to generate AR Code:\n{e}")

    def export_cheat(self):
        self.update_data_from_ui()
        try:
            target_str = self.course_data["target_slot"]
            target_index = int(target_str.split(" - ")[0])

            watts = self.course_data["watts"]
            route = RouteImage[self.course_data["route_image"]]
            types = [
                Type[self.course_data["type1"]],
                Type[self.course_data["type2"]],
                Type[self.course_data["type3"]]
            ]

            p_slots = []
            for p in self.course_data["pokemon"]:
                slot = PokeWalkerSlot(
                    species=Species[p["species"]],
                    level=p["level"],
                    item=p["held_item"],
                    form=p["form"],
                    gender=Gender["MALE"],
                    moves=[Move[p["move1"]], Move[p["move2"]], Move[p["move3"]], Move[p["move4"]]],
                    step_requirement=p["steps"],
                    rarity_weight=p["rarity"]
                )
                p_slots.append(slot)

            i_slots = []
            for i in self.course_data["items"]:
                slot = PokeWalkerItem(
                    item=i["name"],
                    step_requirement=i["steps"],
                    rarity_weight=i["rarity"]
                )
                i_slots.append(slot)

            course = PokeWalkerCourse(
                target_course_index=target_index,
                watt_requirement=watts,
                route_image=route,
                group_a=p_slots[0:2],
                group_b=p_slots[2:4],
                group_c=p_slots[4:6],
                items=i_slots,
                special_types=types
            )

            # Fetch Target Game/Region details dynamically
            game = self.course_data["target_game"]
            region = self.course_data["target_region"]
            lookup_key = f"{game} {region}"
            
            # Fallback to standard SoulSilver USA if combination doesn't exist
            db_info = GAME_DB.get(lookup_key, {"text": "IPGE", "value": 0x00000000, "title": "Pokemon SoulSilver"})

            cheat_binary = course.to_usr_cheat_dat(
                game_id_text=db_info["text"],
                game_id_value=db_info["value"],
                game_title_text=db_info["title"]
            )

            filepath = filedialog.asksaveasfilename(
                title="Save usrcheat.dat",
                defaultextension=".dat",
                initialfile="usrcheat.dat",
                filetypes=[("Action Replay DB", "*.dat"), ("All files", "*.*")]
            )
            
            if filepath:
                with open(filepath, "wb") as f:
                    f.write(cheat_binary)
                messagebox.showinfo("Success!", f"Cheat database successfully generated at:\n{filepath}\n\nLoad this into your flashcart/emulator!")

        except Exception as e:
            messagebox.showerror("Export Error", f"Failed to generate cheat data:\n{e}")

