def setup_autocomplete(widget, full_list, min_chars=4):
    """Adds a dynamic pop-up autofill to a Combobox."""
    def on_keyrelease(event):
        if event.keysym in ('Up', 'Down', 'Left', 'Right', 'Return', 'Tab', 'Escape', 'Shift_L', 'Shift_R', 'Caps_Lock'):
            return
            
        typed = widget.get()
        
        if len(typed) >= min_chars:
            hits = [x for x in full_list if typed.lower() in x.lower()]
            widget['values'] = hits
            if hits:
                try:
                    widget.tk.eval(f'ttk::combobox::Post {widget._w}')
                except Exception:
                    pass
            else:
                try:
                    widget.tk.eval(f'ttk::combobox::Unpost {widget._w}')
                except Exception:
                    pass
        else:
            widget['values'] = full_list
            try:
                widget.tk.eval(f'ttk::combobox::Unpost {widget._w}')
            except Exception:
                pass

    widget.bind('<KeyRelease>', on_keyrelease)
    widget.bind('<Button-1>', lambda e: widget.config(values=full_list))


class PokemonDialog(tk.Toplevel):
    def __init__(self, parent, title, initial=None):
        super().__init__(parent)
        self.title(title)
        self.geometry("800x1280")
        self.result = None
        initial = initial or {}

        self.species = tk.StringVar(value=initial.get("species", "BULBASAUR"))
        self.level = tk.StringVar(value=str(initial.get("level", 1)))
        self.form = tk.StringVar(value=str(initial.get("form", 0)))
        self.rarity = tk.StringVar(value=str(initial.get("rarity", 10)))
        self.steps = tk.StringVar(value=str(initial.get("steps", 0)))
        self.held_item = tk.StringVar(value=initial.get("held_item", "None"))
        self.move1 = tk.StringVar(value=initial.get("move1", "NONE"))
        self.move2 = tk.StringVar(value=initial.get("move2", "NONE"))
        self.move3 = tk.StringVar(value=initial.get("move3", "NONE"))
        self.move4 = tk.StringVar(value=initial.get("move4", "NONE"))

        frame = tk.Frame(self, padx=15, pady=15)
        frame.pack(fill=tk.BOTH, expand=True)

        fields = [
            ("Species:", self.species, POKEMON_SPECIES_LIST),
            ("Level:", self.level, None),
            ("Form ID:", self.form, None),
            ("Rarity Weight:", self.rarity, None),
            ("Required Steps:", self.steps, None),
            ("Held Item:", self.held_item, ITEMS),
            ("Move 1:", self.move1, MOVE_LIST),
            ("Move 2:", self.move2, MOVE_LIST),
            ("Move 3:", self.move3, MOVE_LIST),
            ("Move 4:", self.move4, MOVE_LIST),
        ]

        for i, (label_text, var, options) in enumerate(fields):
            tk.Label(frame, text=label_text).grid(row=i, column=0, sticky="e", pady=3, padx=(0, 5))
            if options is not None:
                cb = ttk.Combobox(frame, textvariable=var, values=options, width=22)
                cb.grid(row=i, column=1, sticky="w", pady=3)
                setup_autocomplete(cb, options, min_chars=4)
            else:
                tk.Entry(frame, textvariable=var, width=25).grid(row=i, column=1, sticky="w", pady=3)

        btn_frame = tk.Frame(self)
        btn_frame.pack(pady=10)
        tk.Button(btn_frame, text="OK", command=self.on_ok, width=8).pack(side=tk.LEFT, padx=5)
        tk.Button(btn_frame, text="Cancel", command=self.destroy, width=8).pack(side=tk.LEFT, padx=5)

        self.transient(parent)
        self.wait_visibility()
        self.grab_set()
        self.wait_window(self)

    def on_ok(self):
        try:
            species = self.species.get().strip()
            item = self.held_item.get().strip()
            moves = [self.move1.get().strip(), self.move2.get().strip(), self.move3.get().strip(), self.move4.get().strip()]

            if species not in POKEMON_SPECIES_LIST:
                messagebox.showerror("Invalid Input", f"'{species}' is not a valid Species.", parent=self)
                return
            if item not in ITEMS:
                messagebox.showerror("Invalid Input", f"'{item}' is not a valid Item.", parent=self)
                return
            for m in moves:
                if m not in MOVE_LIST:
                    messagebox.showerror("Invalid Input", f"'{m}' is not a valid Move.", parent=self)
                    return

            self.result = {
                "species": species,
                "level": int(self.level.get()),
                "form": int(self.form.get()),
                "gender": "MALE",
                "rarity": int(self.rarity.get()),
                "steps": int(self.steps.get()),
                "held_item": item,
                "move1": moves[0],
                "move2": moves[1],
                "move3": moves[2],
                "move4": moves[3]
            }
            self.destroy()
        except ValueError:
            messagebox.showerror("Invalid Input", "Level, Form, Rarity, and Steps must be whole numbers.", parent=self)


